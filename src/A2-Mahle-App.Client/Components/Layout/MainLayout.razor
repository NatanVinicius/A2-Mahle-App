@using A2MahleApp.Client.Components.Layout.Header
@using A2MahleApp.Client.Components.Layout.NavMenu
@using A2MahleApp.Client.Components.Layout.Statistics
@using A2MahleApp.Client.Components.Shared
@using A2MahleApp.Client.Components.Shared.ComunicationTestPopup
@using A2MahleApp.Client.Services
@inject UpdateService UpdateService
@implements IDisposable
@inherits LayoutComponentBase

<div class="flex flex-col h-screen overflow-hidden bg-background">

    <Header />

    <div class="flex flex-1 min-h-0 w-full overflow-hidden">

        <NavMenu />

        <div class="flex flex-col flex-1 min-w-0 min-h-0">

            <MainContent>
                @Body
            </MainContent>
        </div>

    </div>

    <footer class="bg-primary shrink-0 mt-4 px-6 py-2 text-white">
        <p class="text-xs">Powered by A2 Vision Experts</p>
    </footer>

    <ComunicationTestPopup />

    <UpdateOverlay />

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        UpdateService.StateChanged += OnUpdateStateChanged;
        await UpdateService.CheckForUpdateAsync();
    }

    private void OnUpdateStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UpdateService.StateChanged -= OnUpdateStateChanged;
    }
}
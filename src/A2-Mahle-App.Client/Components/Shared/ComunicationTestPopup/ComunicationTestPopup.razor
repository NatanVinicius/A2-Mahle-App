@if (PopupService.IsCommunicationTestOpen)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center">

		<!-- Overlay -->
		<div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

		<!-- Popup -->
		<div class="relative z-10 w-130 rounded-2xl bg-background p-6 text-black shadow-2xl">

			<!-- Header -->
			<div class="relative mb-6 flex items-center justify-center">

				<h2 class="text-center text-xl font-semibold">
					Teste de Comunicações
				</h2>

				<button type="button" onclick="@OnClose" aria-label="Fechar"
						class="absolute right-0 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-gray-400 transition hover:bg-white/10 hover:text-white disabled:cursor-not-allowed disabled:opacity-40">

					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
						 stroke="CurrentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
						 class="lucide lucide-x-icon lucide-x text-black/50">
						<path d="M18 6 6 18" />
						<path d="m6 6 12 12" />
					</svg>

				</button>

			</div>

			<!-- IV4 -->
			<div class="mb-6">

				<h3 class="mb-4 text-base font-semibold text-secondary">
					IV4
				</h3>

				<div class="flex flex-col gap-3">
					<div class="flex items-center justify-between rounded-lg bg-white/5 px-4 py-3">

						<span class="text-sm @GetIconType(IV4IsConnected)">
							IP: @ComunicationTestServiceModel.Value.IV4
						</span>

					</div>
				</div>

			</div>

			<div class="mb-6">

				<h3 class="mb-4 text-base font-semibold text-secondary">
					HOST
				</h3>

				<div class="flex flex-col gap-3">
					<div class="flex items-center justify-between rounded-lg bg-white/5 px-4 py-3">

						<span class="text-sm @GetIconType(HostIsConnected)">
							IP: @ComunicationTestServiceModel.Value.Host
						</span>

					</div>
				</div>

			</div>

			<!-- Test button -->
			<div class="flex justify-end">
				<button type="button" disabled="@IsLoading" @onclick="TestConnections"
						class="flex h-11 w-40 cursor-pointer items-center justify-center gap-3 rounded-lg bg-primary font-semibold transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">

					<div class="flex h-4 w-4 items-center justify-center transition-all duration-150"
						 style="opacity:@(IsLoading ? "1" : "0"); margin-right:@(IsLoading ? "8px" : "-16px")">

						<div
							class="h-4 w-4 animate-spin rounded-full border-2 border-dotted border-white border-t-transparent">
						</div>

					</div>
					<span class="mr-3 text-white">Testar</span>
				</button>
			</div>
		</div>
	</div>
}

@using A2MahleApp.Client.Services
@inject UpdateService UpdateService
@implements IDisposable

@if (UpdateService.State is not UpdateState.Idle)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-6">
        <div class="w-full max-w-md rounded-lg bg-white p-8 shadow-2xl">

            @switch (UpdateService.State)
            {
                case UpdateState.Checking:
                    <h2 class="text-xl font-bold text-primary">Verificando atualização</h2>
                    <p class="mt-3 text-sm">Verificando se existe uma nova versão...</p>
                    break;

                case UpdateState.NoUpdate:
                    <h2 class="text-xl font-bold text-primary">Aplicação atualizada</h2>
                    <p class="mt-3 text-sm">Não existe uma nova versão disponível.</p>
                    break;

                case UpdateState.Downloading:
                    <h2 class="text-xl font-bold text-primary">Atualizando aplicação</h2>
                    <p class="mt-3 text-sm">
                        Nova versão: <strong>@UpdateService.NewVersion</strong>
                    </p>
                    <p class="mt-2 text-sm">
                        Baixando atualização: <strong>@UpdateService.Progress%</strong>
                    </p>
                    <progress class="mt-4 h-2 w-full" value="@UpdateService.Progress" max="100"></progress>
                    break;

                case UpdateState.Installing:
                    <h2 class="text-xl font-bold text-primary">Instalando atualização</h2>
                    <p class="mt-3 text-sm">
                        Aplicando a versão <strong>@UpdateService.NewVersion</strong>...
                    </p>
                    break;

                case UpdateState.Error:
                    <h2 class="text-xl font-bold text-primary">Não foi possível atualizar</h2>
                    <p class="mt-3 wrap-break-word text-sm">
                        @UpdateService.ErrorMessage
                    </p>
                    break;

                case UpdateState.Offline:
                    <h2 class="text-xl font-bold text-primary">Sem conexão para atualizar</h2>
                    <p class="mt-3 wrap-break-word text-sm">
                        @UpdateService.ErrorMessage
                    </p>
                    break;
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        UpdateService.StateChanged += OnStateChanged;
        _ = UpdateService.CheckAndApplyUpdateAsync();
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UpdateService.StateChanged -= OnStateChanged;
    }
}

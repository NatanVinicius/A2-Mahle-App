@using A2MahleApp.Client.Services
@inject UpdateService UpdateService

@if (UpdateService.State is not UpdateState.Idle and not UpdateState.Offline)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-6">
        <div class="w-full max-w-md rounded-lg bg-white p-8 shadow-2xl">

            @switch (UpdateService.State)
            {
                case UpdateState.Checking:
                    <h2 class="text-xl font-bold text-primary">Verificando atualização</h2>
                    <p class="mt-3 text-sm">Verificando se existe uma nova versão...</p>
                    break;

                case UpdateState.UpdateAvailable:
                    <h2 class="text-xl font-bold text-primary">Nova versão disponível</h2>
                    <p class="mt-3 text-sm">
                        Versão atual: <strong>@UpdateService.CurrentVersion</strong>
                    </p>
                    <p class="text-sm">
                        Nova versão: <strong>@UpdateService.NewVersion</strong>
                    </p>
                    <button class="mt-6 w-full rounded bg-primary px-4 py-3 text-sm font-bold text-white"
                            @onclick="UpdateService.DownloadUpdateAsync">
                        Baixar atualização
                    </button>
                    break;

                case UpdateState.Downloading:
                    <h2 class="text-xl font-bold text-primary">Baixando atualização</h2>
                    <p class="mt-3 text-sm">Versão: <strong>@UpdateService.NewVersion</strong></p>
                    <p class="mt-2 text-sm">Progresso: <strong>@UpdateService.Progress%</strong></p>
                    <progress class="mt-4 h-2 w-full" value="@UpdateService.Progress" max="100"></progress>
                    break;

                case UpdateState.Ready:
                    <h2 class="text-xl font-bold text-primary">Atualização pronta</h2>
                    <p class="mt-3 text-sm">
                        A versão <strong>@UpdateService.NewVersion</strong> está pronta para ser instalada.
                    </p>
                    <button class="mt-6 w-full rounded bg-primary px-4 py-3 text-sm font-bold text-white"
                            @onclick="UpdateService.InstallUpdate">
                        Atualizar agora
                    </button>
                    break;

                case UpdateState.Installing:
                    <h2 class="text-xl font-bold text-primary">Instalando atualização</h2>
                    <p class="mt-3 text-sm">Aplicando a nova versão...</p>
                    break;

                case UpdateState.Error:
                    <h2 class="text-xl font-bold text-primary">Erro ao atualizar</h2>
                    <p class="mt-3 break-words text-sm">@UpdateService.ErrorMessage</p>
                    <button class="mt-6 w-full rounded bg-primary px-4 py-3 text-sm font-bold text-white"
                            @onclick="UpdateService.CheckForUpdateAsync">
                        Tentar novamente
                    </button>
                    break;
            }
        </div>
    </div>
}

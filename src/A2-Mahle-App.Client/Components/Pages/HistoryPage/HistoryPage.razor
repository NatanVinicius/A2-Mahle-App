@page "/history"

<main class="h-full flex-1 items-center justify-center">
    <div class="relative my-4 h-8 w-30 shrink-0 overflow-hidden rounded-md bg-primary">
        <span class="flex h-full items-center justify-center text-sm font-bold text-white">
            Histórico
        </span>

        <div class="absolute top-[-10%] right-5 h-[280%] w-1 rotate-20 bg-background"></div>
    </div>

    <div class="shadow-xs mt-1 flex w-full gap-6 rounded-md p-4">

        <form>
            <label for="history-date" class="text-heading mb-2.5 block text-sm font-medium">
                Data
            </label>

            <input id="history-date" type="date"
                   class="text-heading shadow-xs border-border bg-border block w-full rounded-md border px-3 py-2.5 text-sm outline-0 placeholder:text-body" />
        </form>

        <form>
            <label for="countries" class="text-heading mb-2.5 block text-sm font-medium">Julgamento</label>
            <select
                class="text-heading shadow-xs border-border bg-border block w-full rounded-md border px-3 py-2.5 text-sm placeholder:text-body focus:ring-brand focus:border-brand">
                <option>Todos</option>
                <option>Aprovadas</option>
                <option>Reprovadas</option>
            </select>
        </form>

    </div>

    <div class="shadow-xs relative mt-4 flex-1 overflow-x-auto rounded-md">
        <table class="text-body w-full text-left text-sm rtl:text-right">

            <thead class="text-body bg-card sticky top-0 border-b border-white/5 bg-primary text-sm text-white">
                <tr>
                    <th class="px-6 py-3 font-medium">Data</th>
                    <th class="px-6 py-3 font-medium">Turno</th>
                    <th class="px-6 py-3 font-medium">Produzidas</th>
                    <th class="px-6 py-3 font-medium">Aprovadas</th>
                    <th class="px-6 py-3 font-medium">Reprovadas</th>
                    <th class="px-6 py-3 font-medium">Reject Rate</th>
                    <th class="px-6 py-3 font-medium">Imagens</th>
                </tr>
            </thead>

            <tbody>
                <tr class="bg-border border-b border-white/5">

                    <td class="px-6 py-4">
                        1
                    </td>

                    <td class="px-6 py-4">
                        1
                    </td>


                    <td class="px-6 py-4">
                        1
                    </td>

                    <td class="px-6 py-4 text-green-500">
                        1
                    </td>

                    <td class="px-6 py-4 text-red-500">
                        1
                    </td>

                    <td class="px-6 py-4">
                        1
                    </td>

                    <td class="flex px-6 py-4">
                        <i class="fa-solid fa-image"></i>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <div class="mt-6 flex w-full justify-end">
        <button class="cursor-pointer rounded-lg border bg-red-500 px-8 py-2 font-semibold text-white
            transition hover:bg-red-500/80
            disabled:cursor-not-allowed disabled:opacity-20">
            Exportar PDF
        </button>
    </div>
</main>

@using A2MahleApp.Application.Features.History.Models

@page "/history"

<main class="flex h-full min-h-0 flex-1 flex-col pr-6">
    <div class="relative my-4 h-8 w-30 shrink-0 overflow-hidden rounded-md bg-primary">
        <span class="flex h-full items-center justify-center text-sm font-bold text-white">
            Histórico
        </span>
        <div class="absolute top-[-10%] right-5 h-[280%] w-1 rotate-20 bg-background"></div>
    </div>

    <div class="shadow-xs mt-1 flex w-full shrink-0 flex-wrap items-end gap-6 rounded-md p-4">
        <form>
            <label for="history-date" class="text-heading mb-2.5 block text-sm font-medium">Data</label>
            <input id="history-date" type="date" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged"
                   class="text-heading shadow-xs border-border bg-border block w-full rounded-md border px-3 py-2.5 text-sm outline-0 placeholder:text-body" />
        </form>

        <form>
            <label for="history-judgment" class="text-heading mb-2.5 block text-sm font-medium">Julgamento</label>
            <select id="history-judgment" value="@_judgment" @onchange="OnJudgmentChanged"
                    disabled="@(_viewMode == HistoryViewMode.Production)"
                    class="text-heading shadow-xs border-border bg-border block w-full rounded-md border px-3 py-2.5 text-sm placeholder:text-body disabled:cursor-not-allowed disabled:opacity-50">
                <option value="All">Todos</option>
                <option value="Approved">Aprovadas</option>
                <option value="Rejected">Reprovadas</option>
            </select>
        </form>

        <div>
            <span class="text-heading mb-2.5 block text-sm font-medium">Visualização</span>
            <div class="flex overflow-hidden rounded-md border border-border">
                <button type="button" @onclick="() => OnViewModeChanged(HistoryViewMode.Production)"
                        class="px-4 py-2.5 text-sm font-medium @( _viewMode == HistoryViewMode.Production ? "bg-primary text-white" : "bg-border text-body" )">
                    Produção
                </button>
                <button type="button" @onclick="() => OnViewModeChanged(HistoryViewMode.Inspection)"
                        class="px-4 py-2.5 text-sm font-medium @( _viewMode == HistoryViewMode.Inspection ? "bg-primary text-white" : "bg-border text-body" )">
                    Inspeção
                </button>
            </div>
        </div>
    </div>

    <div id="pdf-export-area" class="shadow-xs relative mt-4 min-h-0 flex-1 overflow-auto rounded-md">
        @if (_loading)
        {
            <div class="flex h-full items-center justify-center text-sm text-body">
                Carregando histórico...
            </div>
        }
        else if (_viewMode == HistoryViewMode.Production)
        {
            <table class="text-body min-w-full w-full text-left text-sm rtl:text-right">
                <thead class="sticky top-0 z-10 border-b border-white/5 bg-primary text-sm text-white">
                    <tr>
                        <th class="px-6 py-3 font-medium">Data</th>
                        <th class="px-6 py-3 font-medium">Produzidas</th>
                        <th class="px-6 py-3 font-medium">Aprovadas</th>
                        <th class="px-6 py-3 font-medium">Reprovadas</th>
                        <th class="px-6 py-3 font-medium">Reject Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ProductionHistoryItem production in _productions)
                    {
                        <tr class="border-b border-white/5 bg-border">
                            <td class="px-6 py-4">@production.Date.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-4">@production.Produced</td>
                            <td class="px-6 py-4 ">@production.Approved</td>
                            <td class="px-6 py-4 ">@production.Rejected</td>
                            <td class="px-6 py-4">@production.RejectRate.ToString("0.#")%</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_productions.Count == 0)
            {
                <div class="p-8 text-center text-sm text-body">Nenhuma produção encontrada para a data selecionada.</div>
            }
            else
            {
                <div id="history-chart-export" class="bg-border mt-0 flex w-full items-center justify-center gap-15">

                    <div class="flex ">
                        <div class="flex flex-col items-start justify-center gap-4">
                            <div class="flex items-center gap-2">
                                <span class="h-3 w-3 rounded-full bg-green-500"></span>

                                <span class="text-body text-sm">
                                    Aprovadas:
                                    <strong>
                                        @_productions[0].Approved
                                    </strong>
                                </span>
                            </div>

                            <div class="flex items-center gap-1">
                                <span class="h-3 w-3 rounded-full bg-red-500"></span>

                                <span class="text-body text-sm">
                                    Reprovadas:
                                    <strong>
                                        @_productions[0].Rejected
                                    </strong>
                                </span>
                            </div>
                        </div>

                        <div class="flex justify-center">
                            <div id="production-chart" class="w-full">
                            </div>
                        </div>

                    </div>

                    <div class="flex">
                        <div class="flex flex-col items-start justify-center gap-4">
                            <div class="flex items-center gap-2">
                                <span class="h-3 w-3 rounded-full bg-[#b5b5b5]"></span>

                                <span class="text-body text-sm">
                                    Sem rejeito:
                                    <strong>
                                        @((100 - _productions[0].RejectRate).ToString("0.#"))%
                                    </strong>
                                </span>
                            </div>

                            <div class="flex items-center gap-2">
                                <span class="h-3 w-3 rounded-full bg-[#ff6905]"></span>

                                <span class="text-body text-sm">
                                    Rejeito
                                </span>
                            </div>
                        </div>

                        <div class="flex justify-center">
                            <div id="reject-rate-chart"></div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <table class="text-body min-w-full w-full text-left text-sm rtl:text-right">
                <thead class="sticky top-0 z-10 border-b border-white/5 bg-primary text-sm text-white">
                    <tr>
                        <th class="px-6 py-3 font-medium">Data e hora</th>
                        <th class="px-6 py-3 font-medium">Julgamento</th>
                        <th class="px-6 py-3 font-medium">Tempo do ciclo</th>
                        <th class="px-6 py-3 font-medium">Imagem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (InspectionHistoryItem inspection in _inspections)
                    {
                        <tr class="border-b border-white/5 bg-border">
                            <td class="px-6 py-4">@inspection.DateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="px-6 py-4 font-medium @JudgmentCss(inspection.Status)">@JudgmentText(inspection.Status)
                            </td>
                            <td class="px-6 py-4">@inspection.CycleTimeMilliseconds ms</td>
                            <td class="px-6 py-2">
                                @if (inspection.Status == A2MahleApp.Domain.Features.Inspection.Enums.InspectionStatus.Rejected
                                  && !string.IsNullOrWhiteSpace(inspection.EvidenceImagePath))
                                {
                                    <button type="button" @onclick="() => OpenEvidenceAsync(inspection)"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded border border-border bg-background hover:bg-border"
                                            title="Abrir pasta da evidência" aria-label="Abrir pasta da evidência">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-body/50">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_inspections.Count == 0)
            {
                <div class="p-8 text-center text-sm text-body">Nenhuma inspeção encontrada para os filtros selecionados.</div>
            }
        }
    </div>

    @if (_viewMode == HistoryViewMode.Production)
    {
        <div class="mt-6 flex w-full shrink-0 justify-end">
            <button type="button" @onclick="OnExportPdfClick" disabled="@_isExportingPdf"
                    class="rounded-lg border bg-red-500 px-8 py-2 font-semibold text-white cursor-pointer disabled:cursor-not-allowed disabled:opacity-80">
                @if (_isExportingPdf)
                {
                    <span class="inline-flex items-center gap-2">
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span>
                        <span>Exportando...</span>
                    </span>
                }
                else
                {
                    <span>Exportar PDF</span>
                }
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @_errorMessage
        </div>
    }
</main>

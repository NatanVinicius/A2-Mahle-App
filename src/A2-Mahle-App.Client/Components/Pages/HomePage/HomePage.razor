@page "/"
@using A2MahleApp.Client.Components.Layout.Statistics

<PageTitle>Home</PageTitle>

<main class="flex h-full min-h-0 w-full flex-col pr-6">

    <div class="relative my-4 h-8 w-30 shrink-0 overflow-hidden rounded-sm bg-primary">
        <span class="flex h-full items-center justify-center text-sm font-bold text-white">
            Inspeção
        </span>

        <div class="absolute top-[-10%] right-5 h-[280%] w-1 rotate-20 bg-background"></div>
    </div>

    <div class="flex min-h-0 flex-1 overflow-hidden rounded-sm gap-4">
        <div class="flex min-h-0 flex-1 items-center justify-center overflow-hidden rounded-sm">
            <img src="@_imageSource" alt="Imagem da inspeção" class="h-full w-full rounded-sm object-fill" />
        </div>
        <Statistics />
    </div>
</main>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>A2MahleApp.Infrastructure</RootNamespace>
    <AssemblyName>A2-Mahle-App.Infrastructure</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\A2-Mahle-App.Application\A2-Mahle-App.Application.csproj" />
    <ProjectReference Include="..\A2-Mahle-App.Domain\A2-Mahle-App.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configuration\" />
    <EmbeddedResource Include="FakeData\testimage.bmp" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Features\Export\Assets\mahle-logo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Keyence.IV4.Sdk">
      <HintPath>lib\Keyence.IV4.Sdk.dll</HintPath>
    </Reference>
    <None Include="lib\Keyence.IV4.Sdk.Lib.dll" Link="Keyence.IV4.Sdk.Lib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
